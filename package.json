{
  "name": "eyedroptracker",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/licenses.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run test:browser",
    "ext:build": "node scripts/extension.mjs",
    "oscar:standin": "node oscar/standin/server.mjs",
    "reader:bench": "node scripts/reader-bench.mjs",
    "reader:spelling": "node scripts/spelling-bench.mjs",
    "reader:score": "node scripts/reader-score.mjs tests/fixtures/independent-notes-1.json && node scripts/reader-score.mjs tests/fixtures/independent-notes-2.json && node scripts/reader-score.mjs tests/fixtures/independent-notes-3.json",
    "app:version": "node scripts/version.mjs",
    "app:sync": "node scripts/version.mjs && vite build && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "app:icons": "node scripts/icons.cjs",
    "app:screens": "node scripts/store-screens.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "6.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/local-notifications": "^7.0.7",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  },
  "license": "Apache-2.0",
  "description": "Eye drop calendars, prescriptions and reminders for eye care teams and their patients.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahadbutt-git/eyedropcalendar"
  },
  "extensionVersion": "0.6.4",
  "engines": {
    "node": ">=22"
  }
}
